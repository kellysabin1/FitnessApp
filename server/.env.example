# Copy to .env (never commit .env)
ANTHROPIC_API_KEY=sk-ant-...
# A long random password; paste the same value into the app (You → Coach server → App password)
APP_TOKEN=change-me-to-something-long-and-random
# Optional — only needed for Oura
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Optional — defaults to claude-opus-5-5
# COACH_MODEL=claude-opus-5-5
